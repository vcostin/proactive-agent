{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "proactive-agent",
  "version": "0.1.0",
  "identifier": "com.proactive.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "deno run -A scripts/run-frontend.ts dev",
    "beforeBuildCommand": "deno run -A scripts/run-frontend.ts build"
  },
  "app": {
    "windows": [
      {
        "title": "Proactive Agent",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": []
  }
}
