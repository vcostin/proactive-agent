{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "proactive-agent",
  "version": "0.1.0",
  "identifier": "com.proactive.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Proactive Agent",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "../binaries/llama/llama-server",
      "../binaries/parakeet/parakeet-server",
      "../binaries/piper/piper"
    ],
    "resources": {
      "../binaries/llama/ggml.dll": "ggml.dll",
      "../binaries/llama/ggml-base.dll": "ggml-base.dll",
      "../binaries/llama/ggml-rpc.dll": "ggml-rpc.dll",
      "../binaries/llama/ggml-vulkan.dll": "ggml-vulkan.dll",
      "../binaries/llama/llama.dll": "llama.dll",
      "../binaries/llama/llama-common.dll": "llama-common.dll",
      "../binaries/llama/mtmd.dll": "mtmd.dll",
      "../binaries/piper/espeak-ng.dll": "espeak-ng.dll",
      "../binaries/piper/onnxruntime.dll": "onnxruntime.dll",
      "../binaries/piper/onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll",
      "../binaries/piper/piper_phonemize.dll": "piper_phonemize.dll"
    }
  }
}
