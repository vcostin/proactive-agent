# Copy this to config.toml and set PROTOC to your local protoc binary.
# lance-* crates require protoc at build time.
#
# Windows (winget): winget install Google.Protobuf
# macOS:            brew install protobuf
# Linux:            apt install protobuf-compiler

[env]
# Windows example:
# PROTOC = "C:/Users/<you>/AppData/Local/Microsoft/WinGet/Packages/Google.Protobuf_.../bin/protoc.exe"
#
# macOS/Linux example:
# PROTOC = "/usr/local/bin/protoc"
